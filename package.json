{
  "name": "anime4k-webextension-plus",
  "version": "0.7.0",
  "description": "Real-time video super-resolution browser extension based on Anime4K.",
  "scripts": {
    "build": "pnpm build:chrome",
    "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode production",
    "build:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode production",
    "dev": "pnpm dev:chrome",
    "dev:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development",
    "watch:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development --watch",
    "watch:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify:wgsl": "node scripts/verify-wgsl-compilation.mjs",
    "check:bundle": "node scripts/check-production-bundle.mjs",
    "check:version": "node scripts/check-release-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.326",
    "@vitest/coverage-v8": "^4.1.11",
    "@webgpu/types": "^0.1.72",
    "copy-webpack-plugin": "^13.0.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.5",
    "eslint": "^10.10.0",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "playwright": "^1.63.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "webpack": "^5.110.3",
    "webpack-cli": "^6.0.1",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-target-webextension": "^2.1.3"
  },
  "dependencies": {
    "anime4k-webgpu-async": "^3.0.0"
  }
}